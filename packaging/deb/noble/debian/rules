#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

#export DH_ALWAYS_EXCLUDE=GIT:.gitignore

%:
	dh $@ 

override_dh_install:
	dh_install
	find ./debian/gluu-server -name "*.gitignore" -delete
override_dh_perl:
override_dh_link:
override_dh_strip:
override_dh_compress:
override_dh_makeshlibs:
override_dh_shlibdeps:
override_dh_strip_nondeterminism:
override_dh_fixperms:
override_dh_dwz:
	dh_fixperms
	[ -f ./debian/gluu-server/opt/gluu-server/lib/x86_64-linux-gnu/libpthread.so.0 ] && \
		chmod 755 ./debian/gluu-server/opt/gluu-server/lib/x86_64-linux-gnu/libpthread.so.0 || true
